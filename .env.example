# Better Auth Configuration
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production-min-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth
# Leave both values empty to keep Google sign-in disabled.
# Google redirect URI (local): http://localhost:3000/api/auth/callback/google
# Google redirect URI (prod): https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Node Environment
NODE_ENV=development

# Vite HMR (for remote/code-server usage)
HMR_HOST=code-server.bee-justice.ts.net
HMR_PROTOCOL=wss
HMR_CLIENT_PORT=3000
