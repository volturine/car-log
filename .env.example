# Copy to .env (production) or .env.dev (preview) and fill in real values.

# --- App ---
# Public origin users visit. Must be https when behind Tailscale Serve.
CAR_LOG_ORIGIN=https://car-log.your-tailnet.ts.net
CAR_LOG_PORT=3000
CAR_LOG_BODY_SIZE_LIMIT=220M
CAR_LOG_DATABASE_URL=/data/car-log.db

# Pinned image for production, e.g. ghcr.io/volturine/car-log:1.2.3
CAR_LOG_IMAGE=

# --- Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional Google social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Tailscale ---
# Auth key from the Tailscale admin console (reusable, ephemeral not required).
TS_AUTHKEY=
# Machine name inside the tailnet; cert domain becomes car-log.<tailnet>.ts.net
TS_HOSTNAME=car-log
TS_EXTRA_ARGS=
