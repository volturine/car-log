# Better Auth Configuration
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-change-this-in-production-min-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Vite HMR (for remote/code-server usage)
HMR_HOST=code-server.bee-justice.ts.net
HMR_PROTOCOL=wss
HMR_CLIENT_PORT=3000
