{
	"name": "car-log",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build/index.js",
		"preview": "vite preview",
		"db:push": "drizzle-kit push",
		"db:push:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs push",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"e2e:install": "playwright install chromium",
		"e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
		"e2e:headed": "node --env-file=.env.test node_modules/@playwright/test/cli.js test --headed"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.35.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"postcss": "^8.5.6",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.5.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.7.2",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.1",
		"neverthrow": "^8.2.0",
		"runed": "^0.37.1",
		"svelte-sonner": "^1.2.1",
		"uuid": "^14.0.2",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=24 <25"
	}
}
