{
	"name": "car-log",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build/index.js",
		"preview": "vite preview",
		"db:push": "drizzle-kit push",
		"db:push:test": "node --env-file=.env.test node_modules/drizzle-kit/bin.cjs push",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"e2e:install": "playwright install chromium",
		"e2e": "node --env-file=.env.test node_modules/@playwright/test/cli.js test",
		"e2e:headed": "node --env-file=.env.test node_modules/@playwright/test/cli.js test --headed",
		"build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
		"cf:dev": "npm run build:cloudflare && wrangler d1 migrations apply CAR_LOG_DB --local --env '' && wrangler dev --env ''",
		"cf:deploy": "npm run build:cloudflare && wrangler d1 migrations apply CAR_LOG_DB --remote --env '' && wrangler deploy --env ''",
		"cf:deploy:dev": "test -n \"$BETTER_AUTH_SECRET\" && npm run build:cloudflare && python3 scripts/reset_cloudflare_dev.py && wrangler d1 migrations apply CAR_LOG_DB --remote --env dev && wrangler deploy --env dev && printf '%s' \"$BETTER_AUTH_SECRET\" | wrangler secret put BETTER_AUTH_SECRET --env dev",
		"test:scripts": "python3 -m unittest scripts/reset_cloudflare_dev_test.py"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261028.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.62.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.154.0"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.7.14",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"neverthrow": "^8.2.0",
		"runed": "^0.38.0",
		"svelte-sonner": "^1.2.2",
		"uuid": "^14.0.3",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=26 <27"
	},
	"overrides": {
		"better-auth": {
			"better-sqlite3": "$better-sqlite3"
		}
	}
}
